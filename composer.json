{
    "name": "daniellopez6/glpi-plugin-iam",
    "description": "IAM - Identity & Access Governance (RBAC matrix, access register, deviations, recertification) plugin for GLPI",
    "type": "glpi-plugin",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "GlpiPlugin\\Iam\\": "src/"
        }
    },
    "scripts": {
        "lint": "phpcs --standard=.phpcs.xml",
        "analyse": "phpstan analyse -c phpstan.neon",
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GlpiPlugin\\Iam\\Tests\\": "tests/"
        }
    }
}
