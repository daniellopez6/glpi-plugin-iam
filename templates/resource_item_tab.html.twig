<div class="card">
   <div class="table-responsive">
      <table class="table table-hover card-table">
         <thead>
            <tr>
               <th>{{ __('Resource', 'iam') }}</th>
               <th>{{ __('Code', 'iam') }}</th>
               <th>{{ __('Criticality', 'iam') }}</th>
               <th>{{ __('Owner (person)', 'iam') }}</th>
               <th>{{ __('Owner (group)', 'iam') }}</th>
               <th>{{ __('Roles', 'iam') }}</th>
               <th>{{ __('Grants', 'iam') }}</th>
            </tr>
         </thead>
         <tbody>
         {% for r in rows %}
            <tr>
               <td><a href="{{ r.url }}">{{ r.name }}</a></td>
               <td>{{ r.code }}</td>
               <td>{{ r.criticality }}</td>
               <td>{{ r.owner }}</td>
               <td>{{ r.group }}</td>
               <td>{{ r.roles }}</td>
               <td>{{ r.grants }}</td>
            </tr>
         {% else %}
            <tr><td colspan="7" class="text-muted">{{ __('No resources are linked to this item.', 'iam') }}</td></tr>
         {% endfor %}
         </tbody>
      </table>
   </div>
   {% if can_add %}
   <div class="card-footer">
      <a href="{{ add_url }}" class="btn btn-primary"><i class="ti ti-plus"></i> {{ __('Add a resource', 'iam') }}</a>
   </div>
   {% endif %}
</div>
