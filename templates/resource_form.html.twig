{# Resource form #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block form_fields %}
   {{ fields.textField('name', item.fields['name'], __('Name'), {'required': true}) }}
   {{ fields.textField('code', item.fields['code'], __('Code', 'iam')) }}
   {% if link_deleted %}
   <div class="col-12">
      <div class="alert alert-warning d-flex align-items-center">
         <i class="ti ti-alert-triangle me-2"></i>
         <span class="badge bg-warning me-2">{{ __('Linked item deleted', 'iam') }}</span>
         {{ __('The inventory item of this resource no longer exists or is in the trashbin. Link another item or keep the record as history.', 'iam') }}
      </div>
   </div>
   {% endif %}
   {% if link %}
      {{ fields.htmlField('', '<a href="' ~ (link.url|e('html_attr')) ~ '">' ~ (link.name|e) ~ '</a>', __('Linked item', 'iam')) }}
   {% endif %}
   {{ fields.dropdownItemsFromItemtypes('items_id', (link ? __('Change linked item', 'iam') : __('Linked item', 'iam')), {
      'itemtypes': itemtypes,
      'itemtype_name': 'itemtype',
      'items_id_name': 'items_id',
      'default_itemtype': preset_type,
      'default_items_id': preset_id,
      'entity_restrict': -1,
      'checkright': true,
      'display_emptychoice': true
   }) }}
   {{ fields.dropdownField('User', 'users_id_owner', item.fields['users_id_owner'], __('Owner (person)', 'iam'), {'right': 'all', 'entity': item.fields['entities_id']}) }}
   {{ fields.dropdownField('Group', 'groups_id_owner', item.fields['groups_id_owner'], __('Owner (group)', 'iam'), {'entity': item.fields['entities_id']}) }}
   {{ fields.dropdownArrayField('criticality', item.fields['criticality'], criticalities, __('Criticality', 'iam')) }}
   {{ fields.dropdownArrayField('review_frequency', item.fields['review_frequency'] ?: 'annual', frequencies, __('Review frequency', 'iam')) }}
   {{ fields.textareaField('comment', item.fields['comment'], __('Comments'), {'full_width': true}) }}
{% endblock %}
